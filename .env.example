VITE_SANITY_PROJECT_ID=your-project-id
VITE_SANITY_DATASET=production

# --- Square (cart & checkout, docs/cart-checkout/PRD.md) --------------------
# Sandbox credentials, from developer.squareup.com → your app → Sandbox.
# Used by scripts/square-inventory-spike.mjs and, later, the server/ service.
# Scopes: ITEMS_READ/WRITE, INVENTORY_READ/WRITE, ORDERS_READ/WRITE, PAYMENTS_WRITE
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_LOCATION_ID=

# Phase 3+. Never client-side — these must not reach the browser bundle.
# SQUARE_ACCESS_TOKEN=
# SQUARE_LOCATION_ID=
# SQUARE_WEBHOOK_SIGNATURE_KEY=

# Phase 3. A Sanity *project* token with Editor rights (sanity.io/manage →
# API → Tokens), not the personal CLI token in ~/.config/sanity/config.json:
# the deployed stock mirror must not depend on a human's login session.
# SANITY_WRITE_TOKEN=
