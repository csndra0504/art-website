{
  "name": "cass-art-api",
  "private": true,
  "type": "module",
  "description": "Checkout API for the cart. Runs TypeScript directly via Node's type stripping \u2014 no build step.",
  "scripts": {
    "dev": "node --experimental-strip-types --no-warnings --env-file-if-exists=../.env --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --experimental-strip-types --no-warnings --env-file-if-exists=../.env --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "typescript": "~5.9.3"
  }
}
